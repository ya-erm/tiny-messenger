# In Docker this defaults to /app/data/store.json.
MESSENGER_DATA_FILE=./data/store.json

# Optional. Defaults to 120 anonymous and 480 authenticated requests per minute.
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_AUTH=480

# Message sending: short burst plus sustained per-user limit.
RATE_LIMIT_MESSAGES_BURST=6
RATE_LIMIT_MESSAGES_BURST_WINDOW_SECONDS=10
RATE_LIMIT_MESSAGES_PER_MINUTE=30

# Web Push. Generate a pair with `pnpm push:keys`. The public key is sent to
# browsers; keep the private key only in the server environment.
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Device gateway. It keeps REST authoritative for messages, pushes inbox
# snapshots, and proxies normalized weather/rates over the same WebSocket.
WS_HOST=0.0.0.0
WS_PORT=3001
WS_UPSTREAM=http://127.0.0.1:3000
WS_INBOX_LIMIT=10
WS_POLL_INTERVAL_MS=2000
