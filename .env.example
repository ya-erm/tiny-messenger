# In Docker this defaults to /app/data/store.json.
MESSENGER_DATA_FILE=./data/store.json
MESSENGER_REALTIME_FILE=./data/realtime.json

# Optional. Defaults to 120 anonymous and 480 authenticated requests per minute.
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_AUTH=480

# Message sending: short burst plus sustained per-user limit.
RATE_LIMIT_MESSAGES_BURST=6
RATE_LIMIT_MESSAGES_BURST_WINDOW_SECONDS=10
RATE_LIMIT_MESSAGES_PER_MINUTE=30

# Web Push. Generate a pair with `pnpm push:keys`. The public key is sent to
# browsers; keep the private key only in the server environment.
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Device WebSocket adapter. It shares the app HTTP port at /ws, keeps REST
# authoritative for messages, and proxies normalized weather/rates.
WS_INBOX_LIMIT=10
WS_POLL_INTERVAL_MS=2000

# Optional production origin check for browser WebSocket authentication.
# Example: https://tm.example.com
WS_ALLOWED_ORIGIN=

# WebRTC ICE. TURN is required for reliable calls across restrictive NATs.
# RTC_TURN_SECRET uses coturn's use-auth-secret / REST credentials mode.
RTC_STUN_URLS=stun:stun.l.google.com:19302
RTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
RTC_TURN_SECRET=
